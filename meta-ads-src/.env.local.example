# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored. Restart `npm run dev` after any change here.
# ---------------------------------------------------------------------------

# --- Meta Marketing API (required) -----------------------------------------
# A System User access token with the `ads_read` permission.
# See README.md > "Getting your Meta credentials" for how to generate one.
META_ACCESS_TOKEN=

# Your ad account ID, including the `act_` prefix. e.g. act_123456789012345
# Leave blank on first run — the app will list the accounts your token can see.
META_AD_ACCOUNT_ID=

# Graph API version. Bump this if Meta deprecates the current one; the app
# surfaces Meta's own error message when a version is unsupported.
META_API_VERSION=v23.0

# Attribution windows used for purchase/ROAS numbers. Comma-separated.
# Meta's Ads Manager default is 7d_click,1d_view.
META_ATTRIBUTION_WINDOWS=7d_click,1d_view


# --- Your targets (optional, used by the rules engine) ----------------------
# Break-even / target ROAS. Ads below this are flagged as losers.
TARGET_ROAS=2.0
# Maximum acceptable cost per purchase, in account currency. Blank = ignore.
TARGET_CPA=


# --- Shopify (optional) ----------------------------------------------------
# Enables blended ROAS (total store revenue / total Meta spend) alongside
# Meta's attributed ROAS. Omit both values to disable the Shopify panel.
# Create at: Shopify admin > Settings > Apps and sales channels >
#            Develop apps > Create an app > Admin API scopes: read_orders
#            (plus read_all_orders if you need orders older than 60 days)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Keep wholesale out of the revenue figures. A handful of large B2B orders
# will otherwise swamp a month of retail and make blended ROAS track invoicing
# rather than ad performance.
# Exclude every order created from a draft. Defaults to true, and it is the
# most reliable of these rules — a draft order was typed into the admin rather
# than placed through the storefront, so it is never ad-driven retail demand.
SHOPIFY_EXCLUDE_DRAFT_ORDERS=true
# Order tags to exclude, comma-separated, case-insensitive.
SHOPIFY_EXCLUDE_TAGS=wholesale
# Blunt catch-all for untagged wholesale. Set it well above your largest
# genuine retail order, or you will delete your best customers from the data.
SHOPIFY_EXCLUDE_ABOVE=
# Exclude Shopify B2B company-account orders. Defaults to true.
SHOPIFY_EXCLUDE_B2B=true


# --- Claude (optional) -----------------------------------------------------
# Enables the written analysis. Without it you still get the rule-based
# findings, which are free and instant.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
